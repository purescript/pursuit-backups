es":"purescript-web-uievents","Web.UIEvent.InputEvent":"purescript-web-uievents","Web.UIEvent.InputEvent.EventTypes":"purescript-web-uievents","Web.UIEvent.InputEvent.InputType":"purescript-web-uievents","Web.UIEvent.KeyboardEvent":"purescript-web-uievents","Web.UIEvent.KeyboardEvent.EventTypes":"purescript-web-uievents","Web.UIEvent.MouseEvent":"purescript-web-uievents","Web.UIEvent.MouseEvent.EventTypes":"purescript-web-uievents","Web.UIEvent.UIEvent":"purescript-web-uievents","Web.UIEvent.WheelEvent":"purescript-web-uievents","Web.UIEvent.WheelEvent.EventTypes":"purescript-web-uievents"},"modules":[{"comments":"Halogen Integration for Force Simulations\n\nProvides subscription-based API for integrating simulations with Halogen components.\n\n## Recommended: High-Level API with Unified Events\n\n```purescript\nimport Hylograph.Simulation (runSimulation, SimulationEvent(..))\nimport Hylograph.ForceEngine.Halogen (toHalogenEmitter)\n\nhandleAction Initialize = do\n  { handle, events } <- liftEffect $ runSimulation config\n  halogenEmitter <- liftEffect $ toHalogenEmitter events\n  void $ H.subscribe $ halogenEmitter <#> SimEvent\n\nhandleAction (SimEvent event) = case event of\n  Tick { alpha } -> H.modify_ _ { alpha = alpha }\n  Completed -> liftEffect $ log \"Done!\"\n  _ -> pure unit\n```\n\n## Lower level: a simulation made with callbacks\n\nFor a `Hylograph.ForceEngine.Simulation` made with `createWithCallbacks`:\n\n```purescript\nhandleAction Initialize = do\n  callbacks <- liftEffect defaultCallbacks\n  sim <- liftEffect $ createWithCallbacks config callbacks\n  emitter <- liftEffect $ subscribeToSimulation sim\n  void $ H.subscribe $ emitter <#> SimulationEvent\n```\n","declarations":[{"children":[],"comments":"Convert a framework-agnostic SimulationEmitter to Halogen's Emitter.\n\nThis is the recommended way to integrate simulations with Halogen.\nIt works with either engine, using the same event model.\n\n```purescript\nimport Hylograph.Simulation (runSimulation, SimulationEvent(..))\nimport Hylograph.ForceEngine.Halogen (toHalogenEmitter)\n\nhandleAction Initialize = do\n  { handle, events } <- liftEffect $ runSimulation config\n  halogenEmitter <- liftEffect $ toHalogenEmitter events\n  void $ H.subscribe $ halogenEmitter <#> SimEvent\n\nhandleAction (SimEvent event) = case event of\n  Tick { alpha, nodeCount } -> do\n    H.modify_ _ { alpha = alpha }\n  Completed -> do\n    liftEffect $ log \"Simulation converged!\"\n  Started -> pure unit\n  Stopped -> pure unit\n```\n","info":{"declType":"value","type":{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hylograph","Simulation","Emitter"],"SimulationEmitter"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect"],"Effect"],"tag":"TypeConstructor"},{"annotation":[],"contents":{"annotation":[],"contents":[{"annotation":[],"contents":[["Halogen","Subscription"],"Emitter"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hylograph","Simulation","Emitter"],"SimulationEvent"],"tag":"TypeConstructor"}],"tag":"TypeApp"},"tag":"ParensInType"}],"tag":"TypeApp"}],"tag":"TypeApp"}},"kind":null,"sourceSpan":{"end":[87,87],"name":"/tmp/7HXJ6S/purescript-hylograph-simulation-halogen-v0.6.0/src/Hylograph/ForceEngine/Halogen.purs","start":[87,1]},"title":"toHalogenEmitter"},{"children":[],"comments":"A Halogen emitter of the engine's events (`Tick`, `Started`, `Stopped`,\n`AlphaDecayed`) for a `Hylograph.ForceEngine.Simulation`.\n\nThe simulation must have been made with `createWithCallbacks`; made\nwith plain `create`, it has no callbacks and the emitter never fires.\n","info":{"declType":"value","type":{"annotation":[],"contents":{"identifier":"row","kind":null,"skolem":null,"type":{"annotation":[],"contents":{"identifier":"linkRow","kind":null,"skolem":null,"type":{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Hylograph","ForceEngine","Simulation"],"Simulation"],"tag":"TypeConstructor"},{"annotation":[],"contents":"row","tag":"TypeVar"}],"tag":"TypeApp"},{"annotation":[],"contents":"linkRow","tag":"TypeVar"}],"tag":"TypeApp"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect"],"Effect"],"tag":"TypeConstructor"},{"annotation":[],"contents":{"annotation":[],"contents":[{"annotation":[],"contents":[["Halogen","Subscription"],"Emitter"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hylograph","ForceEngine","Events"],"SimulationEvent"],"tag":"TypeConstructor"}],"tag":"TypeApp"},"tag":"ParensInType"}],"tag":"TypeApp"}],"tag":"TypeApp"},"visibility":"TypeVarInvisible"},"tag":"ForAll"},"visibility":"TypeVarInvisible"},"tag":"ForAll"}},"kind":null,"sourceSpan":{"end":[110,41],"name":"/tmp/7HXJ6S/purescript-hylograph-simulation-halogen-v0.6.0/src/Hylograph/ForceEngine/Halogen.purs","start":[107,1]},"title":"subscribeToSimulation"}],"name":"Hylograph.ForceEngine.Halogen","reExports":[{"declarations":[{"children":[{"comments":null,"info":{"arguments":[],"declType":"dataConstructor"},"sourceSpan":{"end":[47,9],"name":"/tmp/7HXJ6S/.registry/hylograph-simulation-1.0.0/src/Hylograph/ForceEngine/Events.purs","start":[47,3]},"title":"Tick"},{"comments":null,"info":{"arguments":[],"declType":"dataConstructor"},"sourceSpan":{"end":[48,12],"name":"/tmp/7HXJ6S/.registry/hylograph-simulation-1.0.0/src/Hylograph/ForceEngine/Events.purs","start":[48,3]},"title":"Started"},{"comments":null,"info":{"arguments":[],"declType":"dataConstructor"},"sourceSpan":{"end":[49,12],"name":"/tmp/7HXJ6S/.registry/hylograph-simulation-1.0.0/src/Hylograph/ForceEngine/Events.purs","start":[49,3]},"title":"Stopped"},{"comments":null,"info":{"arguments":[{"annotation":[],"contents":[["Prim"],"Number"],"tag":"TypeConstructor"}],"declType":"dataConstructor"},"sourceSpan":{"end":[50,17],"name":"/tmp/7HXJ6S/.registry/hylograph-simulation-1.0.0/src/Hylograph/ForceEngine/Events.purs","start":[50,3]},"title":"AlphaDecayed"},{"comments":null,"info":{"declType":"instance","dependencies":[],"type":{"annotation":[],"contents":[{"annotation":[],"contents":[["Data","Eq"],"Eq"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hylograph","ForceEngine","Events"],"SimulationEvent"],"tag":"TypeConstructor"}],"tag":"TypeApp"}},"sourceSpan":{"end":[52,35],"name":"/tmp/7HXJ6S/.registry/hylograph-simulation-1.0.0/src/Hylograph/ForceEngine/Events.purs","start":[52,1]},"title":"<anonymous>"},{"comments":null,"info":{"declType":"instance","dependencies":[],"type":{"annotation":[],"contents":[{"annotation":[],"contents":[["Data","Show"],"Show"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hylograph","ForceEngine","Events"],"SimulationEvent"],"tag":"TypeConstructor"}],"tag":"TypeApp"}},"sourceSpan":{"end":[58,52],"name":"/tmp/7HXJ6S/.registry/hylograph-simulation-1.0.0/src/Hylograph/ForceEngine/Events.purs","start":[54,1]},"title":"<anonymous>"}],"comments":"Events that can occur during simulation lifecycle.\n\nThese types are primarily for Halogen integration via subscriptions.\nInternally, callbacks are invoked directly without constructing these values.\n\nUsage with Halogen:\n```purescript\nhandleAction (SimEvent event) = case event of\n  Tick -> liftEffect updateDOMPositions\n  Started -> H.modify_ _ { simRunning = true }\n  Stopped -> H.modify_ _ { simRunning = false }\n  AlphaDecayed alpha -> when (alpha < 0.1) $ liftEffect doSomething\n```\n","info":{"dataDeclType":"data","declType":"data","roles":[],"typeArguments":[]},"kind":null,"sourceSpan":{"end":[50,24],"name":"/tmp/7HXJ6S/.registry/hylograph-simulation-1.0.0/src/Hylograph/ForceEngine/Events.purs","start":[46,1]},"title":"SimulationEvent"},{"children":[],"comments":"Callbacks for simulation events.\n\nAll callbacks are stored in Refs to allow dynamic updates and to keep\nthe tick loop allocation-free (no closures created per-tick).\n\nThe callbacks are `Effect Unit` rather than taking event data because:\n1. Performance: No boxing/unboxing of event data in hot path\n2. Simplicity: Consumers can read simulation state directly if needed\n3. Flexibility: The consumer decides what data they need\n","info":{"arguments":[],"declType":"typeSynonym","type":{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Record"],"tag":"TypeConstructor"},{"annotation":[],"contents":["onTick",{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect","Ref"],"Ref"],"tag":"TypeConstructor"},{"annotation":[],"contents":{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect"],"Effect"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Data","Unit"],"Unit"],"tag":"TypeConstructor"}],"tag":"TypeApp"},"tag":"ParensInType"}],"tag":"TypeApp"},{"annotation":[],"contents":["onStart",{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect","Ref"],"Ref"],"tag":"TypeConstructor"},{"annotation":[],"contents":{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect"],"Effect"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Data","Unit"],"Unit"],"tag":"TypeConstructor"}],"tag":"TypeApp"},"tag":"ParensInType"}],"tag":"TypeApp"},{"annotation":[],"contents":["onStop",{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect","Ref"],"Ref"],"tag":"TypeConstructor"},{"annotation":[],"contents":{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect"],"Effect"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Data","Unit"],"Unit"],"tag":"TypeConstructor"}],"tag":"TypeApp"},"tag":"ParensInType"}],"tag":"TypeApp"},{"annotation":[],"contents":["onAlphaThreshold",{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect","Ref"],"Ref"],"tag":"TypeConstructor"},{"annotation":[],"contents":{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Prim"],"Number"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[["Effect"],"Effect"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Data","Unit"],"Unit"],"tag":"TypeConstructor"}],"tag":"TypeApp"}],"tag":"TypeApp"},"tag":"ParensInType"}],"tag":"TypeApp"},{"annotation":[],"tag":"REmpty"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"TypeApp"}},"kind":null,"sourceSpan":{"end":[84,4],"name":"/tmp/7HXJ6S/.registry/hylograph-simulation-1.0.0/src/Hylograph/ForceEngine/Events.purs","start":[73,1]},"title":"SimulationCallbacks"}],"moduleName":{"item":["Hylograph","ForceEngine","Events"],"package":"purescript-hylograph-simulation"}},{"declarations":[{"children":[],"comments":"Framework-agnostic event emitter\n\nThis is intentionally opaque - use `subscribe` to listen for events.\nThe internal representation is a list of listeners with unique IDs.\n","info":{"dataDeclType":"newtype","declType":"data","roles":[],"typeArguments":[]},"kind":null,"sourceSpan":{"end":[116,4],"name":"/tmp/7HXJ6S/.registry/hylograph-simulation-1.0.0/src/Hylograph/Simulation/Emitter.purs","start":[113,1]},"title":"SimulationEmitter"}],"moduleName":{"item":["Hylograph","Simulation","Emitter"],"package":"purescript-hylograph-simulation"}}]}],"packageMeta":{"dependencies":{"purescript-effect":">=4.0.0 <5.0.0","purescript-halogen-subscriptions":">=2.0.0 <3.0.0","purescript-hylograph-simulation":">=1.0.0 <2.0.0","purescript-maybe":">=6.0.0 <7.0.0","purescript-prelude":">=6.0.2 <7.0.0","purescript-refs":">=6.0.0 <7.0.0"},"description":"Halogen integration for Hylograph force simulations","homepage":"https://github.com/afcondon/purescript-hylograph-simulation-halogen.git","license":["MIT"],"name":"purescript-hylograph-simulation-halogen","repository":{"type":"git","url":"http